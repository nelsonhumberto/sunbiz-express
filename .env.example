# Copy this to .env and fill in the values from your Supabase project.
# Settings → Database → Connection string

# Pooled (required for serverless / Vercel)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (used by `prisma migrate` only)
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Must match `npm run dev` — see package.json (fixed port 3333 avoids clashes with other apps on 3000).
NEXTAUTH_URL="http://localhost:3333"

# ─── EIN PII encryption ──────────────────────────────────────────────────
#
# 32-byte symmetric key used to AES-256-GCM encrypt SSN/ITIN/EIN and
# passport numbers at rest. Generate one with:
#     openssl rand -base64 32
#
# If unset, the app falls back to a NEXTAUTH_SECRET-derived key so EIN
# capture keeps working — but you should set a dedicated key in
# production so PII can be re-encrypted independently of session secrets.
# EIN_ENCRYPTION_KEY="paste-32-byte-base64-key-here"

# ─── Payments demo mode ──────────────────────────────────────────────────
#
# When set to "true", the checkout step shows the "(demo mode)" badge and
# pre-fills the test card values used to exercise the mock checkout. Leave
# unset/false in production-like builds so the form starts blank and the
# trust copy stays neutral ("Secured payment · TLS-encrypted").
NEXT_PUBLIC_PAYMENTS_DEMO_MODE="false"

# ─── Stripe (real payments) ───────────────────────────────────────────────
#
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) for local dev and staging.
# Use live keys (sk_live_... / pk_live_...) in production only.
#
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
#
# Webhook secret — from `stripe listen --forward-to localhost:3333/api/stripe/webhook`
# or from the Stripe dashboard (Developers → Webhooks → your endpoint → Signing secret).
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email ───────────────────────────────────────────────────────────────
#
# Only ONE of the two options below is needed. Priority: Resend > SMTP > console.
#
# OPTION A — Resend (recommended; 3 000 free emails/month)
#   1. Sign up at https://resend.com → Domains → Add Domain → launchforma.com
#   2. Add the SPF / DKIM / DMARC DNS records Resend gives you.
#   3. Create an API key and paste it here.
# RESEND_API_KEY="re_..."
#
# OPTION B — Google Workspace SMTP (free, you already have it)
#   1. Go to myaccount.google.com/apppasswords (must have 2-FA enabled).
#   2. Create an App Password for "Mail" on your device.
#   3. Fill in the variables below.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="admin@launchforma.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16-char App Password (spaces are OK)
# SMTP_SECURE="false"               # true only if port 465
#
# Sender name shown in the recipient's inbox.
# EMAIL_FROM="LaunchForma <no-reply@launchforma.com>"
#
# ── help@launchforma.com routing ──────────────────────────────────────────
# In Google Workspace Admin → Apps → Gmail → Routing, add a rule:
#   Envelope recipient matches "help@launchforma.com"
#   → Also deliver to: admin@launchforma.com
# OR add help@launchforma.com as an alias on Laura's account (simpler).

# ─── Analytics ───────────────────────────────────────────────────────────
#
# PostHog — events, funnels, session replay, feature flags.
# Get your project API key from https://app.posthog.com/project/settings
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
#
# Site URL — used by sitemap.ts, robots.ts, JSON-LD, OG images.
#
# IMPORTANT (May 2026 audit): the entire app — marketing site, wizard,
# checkout, dashboard, and admin — runs on https://launchforma.com. The
# legacy preview hostname (sunbiz-express.vercel.app) is now redirected
# to the canonical host via middleware. Keep this variable set to the
# bare apex (no trailing slash) so canonical tags, sitemap URLs, and
# JSON-LD all line up.
# NEXT_PUBLIC_SITE_URL="https://launchforma.com"
#
# Canonical hosts checked by middleware/host-redirect.ts. Any request
# arriving on a host NOT in this list is 301'd to the canonical host.
# Comma-separated, no protocol. Leave unset to disable the redirect
# (useful in local dev / Vercel previews).
# LF_CANONICAL_HOSTS="launchforma.com,www.launchforma.com"

# ─── Florida Sunbiz name-availability lookup ─────────────────────────────
#
# Resolution order in lib/sunbiz.ts:
#   1. SUNBIZDAILY_API_KEY  → call sunbizdaily.com REST API     (recommended)
#   2. SUNBIZ_SCRAPER_PROXY → scrape via CF-bypass proxy        (filing-time use)
#   3. neither              → direct scrape (will hit Cloudflare; clear error)
#
# The live search.sunbiz.org site is gated by Cloudflare and cannot be reached
# from a plain serverless fetch. Set at least one of the variables below.

# Primary: third-party JSON mirror of Sunbiz's daily bulk feed.
# Free tier, 1,000 requests/hour. Sign up at https://sunbizdaily.com/
# Format: sb_<32 chars>
# SUNBIZDAILY_API_KEY=""

# ─── Sunbiz cloudscraper sidecar (handles older/established entities) ───────
#
# sunbizdaily.com only mirrors RECENT daily feeds, so it 404s on established
# entities. The Python cloudscraper sidecar (scripts/sunbiz-scraper) queries
# the official search.sunbiz.org by document number and finds ANY entity. When
# SUNBIZ_LOCAL_PROXY_URL is set, entity lookups use it FIRST.
#
# Local dev:
#   cd scripts/sunbiz-scraper && python3 -m venv .venv \
#     && .venv/bin/pip install -r requirements.txt && .venv/bin/python app.py
#   SUNBIZ_LOCAL_PROXY_URL="http://localhost:3334"
#
# Production (deploy the sidecar via scripts/sunbiz-scraper/Dockerfile or
# render.yaml to a host, then point Vercel at it):
#   SUNBIZ_LOCAL_PROXY_URL="https://your-sunbiz-scraper.onrender.com"
#   SUNBIZ_PROXY_TOKEN="<long-random-string>"   # MUST match the value set on
#                                               # the scraper service
# SUNBIZ_LOCAL_PROXY_URL=""
# SUNBIZ_PROXY_TOKEN=""
#
# NOTE: SUNBIZ_UPSTREAM_PROXY is set ON the scraper service (not here) and
# routes cloudscraper through a residential/CF-bypass proxy if Cloudflare
# starts blocking the host's datacenter IP.

# (Optional) Cloudflare-bypass proxy for the live search.sunbiz.org scraper.
# Used by `searchSunbizScrape()` for the Phase-2 final ground-truth check
# at filing time. Point this at a passthrough proxy that returns raw HTML.
#   - If the value contains "{url}", it is replaced with the URL-encoded target.
#   - Otherwise we append "?url=<target>" to the proxy URL.
# Examples:
#   ScrapingBee:  https://app.scrapingbee.com/api/v1/?api_key=KEY&render_js=false&url={url}
#   ScraperAPI:   https://api.scraperapi.com/?api_key=KEY&url={url}
#   FlareSolverr: not directly compatible (POST API) — front it with a small adapter.
# SUNBIZ_SCRAPER_PROXY=""

# ── Conversion assistant ("Forma" chatbot) ─────────────────────────────────
# DeepSeek (OpenAI-compatible) API key. Without it the assistant returns 503.
# DEEPSEEK_API_KEY=""
# Optional overrides:
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# ASSISTANT_MODEL="deepseek-v4-pro"   # runs in thinking mode; tool calls handled via @ai-sdk/deepseek
# Inbox that receives assistant human-handoff emails (escalateToHuman tool).
# ASSISTANT_HANDOFF_EMAIL="help@launchforma.com"
